# CIRCLE_PIN と CIRCLE_SECRET は必須（未設定だと API は起動時にエラーになる）。
# Redis の接続情報は下の3組のどれか1組が必要（無いとデータはその端末にしか残らない）。

# --- Redis（Upstash）の接続情報 ---
# 次の3組のうち、URLとトークンが「両方」そろった最初の組が使われます（上ほど優先）。
#   1. CIRCLE_REDIS_REST_URL / CIRCLE_REDIS_REST_TOKEN   このアプリ専用。接続先を固定したい時はこれを使う
#   2. UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN Upstash 公式の名前
#   3. KV_REST_API_URL / KV_REST_API_TOKEN               Vercel のストレージ連携が自動で入れる名前
# どれが使われているかは /api/health の redis_source で確認できる。
# トークンは読み取り専用ではない方（READ_ONLY が付かない方）を使うこと。
CIRCLE_REDIS_REST_URL=https://your-upstash-url.upstash.io
CIRCLE_REDIS_REST_TOKEN=your-upstash-token

# アプリを開くときの4桁PIN（実際の値はここに書かず Vercel 側で設定する）
CIRCLE_PIN=0000

# ログイントークンの署名鍵。下記コマンドで生成し、プロジェクトごとに必ず別の値にする。
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CIRCLE_SECRET=
